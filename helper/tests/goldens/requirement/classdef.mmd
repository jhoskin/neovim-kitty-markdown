id: 1
text: "class styling example"
risk: low
verifymethod: test
}

requirement other_req {
id: 2
text: styled directly
risk: medium
verifymethod: analysis
}

element test_entity {
type: simulation
}

element test_elem {
type: shorthand
}

classDef important fill:#f96,stroke:#333,stroke-width:4px
