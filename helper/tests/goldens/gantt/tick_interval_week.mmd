gantt
    title Weekly ticks
    dateFormat YYYY-MM-DD
    axisFormat %d/%m
    tickInterval 1week
    weekday monday
    todayMarker off
    section Planning
        Scope           :s1, 2023-03-01, 10d
        Estimate        :s2, after s1, 7d
    section Build
        Implement       :b1, after s2, 21d
        Review          :b2, after b1, 5d
