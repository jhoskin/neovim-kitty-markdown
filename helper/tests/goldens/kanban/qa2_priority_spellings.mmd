kanban
  a[Case]
    p1[lower high]@{ priority: 'high' }
    p2[upper HIGH]@{ priority: 'HIGH' }
    p3[very high lower]@{ priority: 'very high' }
    p4[VeryHigh no space]@{ priority: 'VeryHigh' }
    p5[Unquoted]@{ priority: Very Low }
    p6[Double quoted]@{ priority: "Low" }
  b[Odd]
    q1[Number]@{ priority: 1 }
    q2[Trailing space]@{ priority: 'High ' }
    q3[Empty string]@{ priority: '' }
    q4[Medium]@{ priority: Medium }
    q5[Bool]@{ priority: true }
