kanban
  p[Priorities]
    vh[Rotate the signing key]@{ priority: 'Very High' }
    h[Fix the flaky test]@{ priority: 'High' }
    m[Update the dependencies]@{ priority: 'Medium' }
    l[Tidy the README]@{ priority: 'Low' }
